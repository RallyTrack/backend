spring:
  autoconfigure:
    exclude: org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration
  application:
    name: backend

  servlet:
    multipart:
      max-file-size: 500MB
      max-request-size: 1GB

  datasource:
    url: ${DB_URL:jdbc:mariadb://localhost:3307/rallytrack?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Seoul}
    username: ${DB_USERNAME:rallytrack}
    password: ${DB_PASSWORD}
    driver-class-name: org.mariadb.jdbc.Driver

  jpa:
    hibernate:
      # 최초 배포 1회만 update로 테이블 생성, 이후 validate로 운영
      ddl-auto: ${DDL_AUTO:validate}
    open-in-view: false

# JWT 설정
jwt:
  secret: ${JWT_SECRET}
  access-token-expiration: 3600000    # 1시간 (ms)
  refresh-token-expiration: 604800000 # 7일 (ms)

# Swagger 설정
springdoc:
  default-consumes-media-type: application/json
  default-produces-media-type: application/json
  swagger-ui:
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha

# S3 호환 스토리지 설정 (MinIO / AWS S3)
cloud:
  aws:
    s3:
      bucket: ${S3_BUCKET:rallytrack-videos}
      # MinIO endpoint. 비워두면 실제 AWS S3로 동작 (클라우드 복귀 스위치)
      endpoint: ${S3_ENDPOINT:}
      # presigned URL에 서명될 외부 공개 주소 (브라우저가 접근하는 주소)
      public-endpoint: ${S3_PUBLIC_ENDPOINT:}
      # AI 서버가 접근하는 LAN 주소 (비우면 public-endpoint 사용)
      ai-endpoint: ${S3_AI_ENDPOINT:}
      # MinIO는 true, AWS는 false
      path-style: ${S3_PATH_STYLE:true}
    region: ${S3_REGION:us-east-1}
    credentials:
      access-key: ${S3_ACCESS_KEY}
      secret-key: ${S3_SECRET_KEY}

# AI 분석 서버
ai:
  server:
    url: ${AI_SERVER_URL:http://localhost:8000}

app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}
  analysis:
    callback-secret: ${ANALYSIS_CALLBACK_SECRET}
  slack:
    # rally-track-back-log 채널 Incoming Webhook (비우면 알림 비활성)
    webhook-url: ${SLACK_BACK_WEBHOOK:}
